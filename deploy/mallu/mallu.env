# mallu Webmail: Einstellungen für den Betrieb unter webmail.mal.lu.
# Enthält keine Geheimnisse. SESSION_SECRET kommt aus einer eigenen Datei (siehe docker-compose.yml).

# Stalwart direkt ansprechen, nicht über einen Proxy auf demselben Host.
# Sonst sieht Stalwart bei jeder Anmeldung 127.0.0.1 und sperrt nach Fehlversuchen alle aus.
JMAP_SERVER_URL=https://mail.mal.lu
STALWART_FEATURES=true

# Name und Symbole
APP_NAME=mallu Webmail
APP_SHORT_NAME=mallu
APP_DESCRIPTION=Webmail für Postfächer bei mallu Cloud Solutions
FAVICON_URL=/branding/mallu-app-icon.svg
PWA_ICON_URL=/branding/mallu-app-icon.svg
PWA_THEME_COLOR=#2563EB
PWA_BACKGROUND_COLOR=#FFFFFF

# Seitenleiste: nur die Bildmarke, sie wird 24 × 24 px groß gezeigt.
APP_LOGO_LIGHT_URL=/branding/mallu-bildmarke-blau.svg
APP_LOGO_DARK_URL=/branding/mallu-bildmarke-weiss.svg

# Anmeldeseite: volles Logo und Links zur Website
LOGIN_LOGO_LIGHT_URL=/branding/mallu-logo-blau-auf-hell.svg
LOGIN_LOGO_DARK_URL=/branding/mallu-logo-weiss.svg
LOGIN_LOGO_MAX_HEIGHT=84px
LOGIN_LOGO_MAX_WIDTH=260px
LOGIN_COMPANY_NAME=mallu Cloud Solutions
LOGIN_WEBSITE_URL=https://mal.lu
LOGIN_IMPRINT_URL=https://mal.lu/impressum
LOGIN_PRIVACY_POLICY_URL=https://mal.lu/datenschutz
LOGIN_USERNAME_PLACEHOLDER=name@ihre-domain.de
LOGIN_SHOW_VERSION=false
